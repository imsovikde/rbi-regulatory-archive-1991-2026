# Secret material must never be committed.

# Key exports, passphrases and tokens belong in the OS keyring or in
# GitHub Actions secrets, never in this repository.


# GPG / SSH private key exports

*.private.asc

gpg-private-*

*-private-key.asc

*-SECRET.asc

id_rsa

id_ed25519

*.pem

*.pfx

*.p12


# Environment and token files

.env

.env.*

*.token

secrets.*


# Revocation certificates (contain key material)

revocation.asc

*.rev


# Pipeline additions: build artefacts, caches, and local environments.
# These are generated on runners or on the owner's machine, never committed.

__pycache__/

*.pyc

.cache/

*.tmp

venv/

.venv/

*_secret*

*.key

*.asc


# Never ignore the archive itself. The lines below are explicit guards:
# data/, manifest/, index/, STATE.json and PROGRESS.md are the product
# of this repository and must always be committed.

!data/

!manifest/

!index/

!STATE.json

!PROGRESS.md
